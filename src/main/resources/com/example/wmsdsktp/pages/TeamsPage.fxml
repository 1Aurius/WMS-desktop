<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.wmsdsktp.Controllers.TeamsPageController"
      spacing="16" style="-fx-padding: 24;">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Teams Management" styleClass="page-title"/>
            <Label text="Manage teams and assign members to groups." styleClass="page-subtitle"/>
        </VBox>
        <Button text="Create Team" styleClass="action-btn" onAction="#onCreateTeam"/>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- Teams List -->
        <VBox styleClass="card" HBox.hgrow="SOMETIMES" spacing="10">
            <Label text="All Teams" styleClass="card-title"/>
            <ListView fx:id="teamsListView" VBox.vgrow="ALWAYS" styleClass="edge-to-edge"/>
        </VBox>
        
        <!-- Team Details -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10" fx:id="teamDetailsPane">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblTeamName" text="Select a team" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAddMember" text="Add Member" styleClass="action-btn" onAction="#onAddMember" visible="false"/>
            </HBox>
            
            <TableView fx:id="membersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMemberId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colMemberName" text="Name" prefWidth="200"/>
                    <TableColumn fx:id="colMemberDate" text="Assigned On" prefWidth="150"/>
                    <TableColumn fx:id="colMemberActions" text="Actions" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>

</VBox>
