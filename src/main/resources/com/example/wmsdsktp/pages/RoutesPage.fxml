<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.wmsdsktp.Controllers.RoutesPageController"
      spacing="12" styleClass="card">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="4">
        <Label text="Gestão de Rotas" styleClass="title"/>
        <Label text="Acompanhe as rotas de transporte com eficiência e estilo." styleClass="subtitle"/>
    </VBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Pesquisar por nome ou estado..." HBox.hgrow="ALWAYS"/>
        <Button text="Aplicar" onAction="#onSearch"/>
        <Button text="Limpar" onAction="#onClear"/>
        <Button text="Nova Rota" onAction="#onNewRoute"/>
    </HBox>

    <Label fx:id="resultCountLabel" text="0 rotas" styleClass="field-label"/>

    <TableView fx:id="routesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nomeCol" text="Nome da Rota" prefWidth="250"/>
            <TableColumn fx:id="estadoCol" text="Estado Atual" prefWidth="120"/>
            <TableColumn fx:id="veiculoCol" text="Veículo Designado" prefWidth="180"/>
            <TableColumn fx:id="equipaCol" text="Equipa Responsável" prefWidth="180"/>
            <TableColumn fx:id="acoesCol" text="Ações" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
