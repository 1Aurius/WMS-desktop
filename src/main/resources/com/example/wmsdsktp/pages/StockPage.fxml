<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.wmsdsktp.Controllers.StockPageController"
      spacing="12" styleClass="card">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="4">
        <Label text="Products in Stock" styleClass="title"/>
        <Label text="Filter current stock by product, posto and quantity" styleClass="subtitle"/>
    </VBox>

    <HBox spacing="8">
        <TextField fx:id="queryField" promptText="Search name or serial code"/>
        <TextField fx:id="postoIdField" promptText="Posto Id"/>
        <TextField fx:id="minQtyField" promptText="Min Qty"/>
        <TextField fx:id="maxQtyField" promptText="Max Qty"/>
        <CheckBox fx:id="inStockOnlyCheck" text="In stock only"/>
        <Button text="Apply" onAction="#onApplyFilters"/>
        <Button text="Clear" onAction="#onClearFilters"/>

        <Button text="Register new stock" onAction="#openCreateNewStockModal"/>
        <Button text="Edit Selected" onAction="#openEditStockModal"/>
    </HBox>

    <Label fx:id="resultCountLabel" text="0 result(s)" styleClass="field-label"/>

    <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="productIdCol" text="Product Id" prefWidth="90"/>
            <TableColumn fx:id="productNameCol" text="Product" prefWidth="220"/>
            <TableColumn fx:id="serialCodeCol" text="Serial Code" prefWidth="180"/>
            <TableColumn fx:id="unitCol" text="Unit" prefWidth="90"/>
            <TableColumn fx:id="quantityCol" text="Quantity" prefWidth="100"/>
            <TableColumn fx:id="postoCol" text="Posto" prefWidth="220"/>
        </columns>
    </TableView>
</VBox>
