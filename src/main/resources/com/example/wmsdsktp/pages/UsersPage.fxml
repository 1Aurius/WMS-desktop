<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.wmsdsktp.Controllers.UtilizadoresPageController"
      spacing="12" styleClass="card">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="4">
        <Label text="Utilizadores" styleClass="title"/>
        <Label text="Gerir todos os utilizadores do sistema" styleClass="subtitle"/>
    </VBox>

    <HBox spacing="8">
        <TextField fx:id="queryField" promptText="Pesquisar por nome"/>
        <Button text="Aplicar" onAction="#onApplyFilters"/>
        <Button text="Limpar" onAction="#onClearFilters"/>
        <Button text="Novo Utilizador" onAction="#openCreateModal"/>
    </HBox>

    <Label fx:id="resultCountLabel" text="0 resultado(s)" styleClass="field-label"/>

    <TableView fx:id="utilizadoresTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="Id" prefWidth="60"/>
            <TableColumn fx:id="nomeCol" text="Nome" prefWidth="200"/>
            <TableColumn fx:id="dnCol" text="Data Nasc." prefWidth="120"/>
            <TableColumn fx:id="isAdminCol" text="Admin" prefWidth="80"/>
            <TableColumn fx:id="isGestorRotasCol" text="Gestor Rotas" prefWidth="110"/>
            <TableColumn fx:id="isGestorCol" text="Gestor" prefWidth="80"/>
            <TableColumn fx:id="isLojaCol" text="Loja" prefWidth="80"/>
            <TableColumn fx:id="isArmazemCol" text="Armazém" prefWidth="90"/>
        </columns>
    </TableView>
</VBox>