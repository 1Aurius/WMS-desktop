<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.wmsdsktp.Controllers.RequisicaoPageController"
      spacing="12" styleClass="card">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="4">
        <Label text="Requisições de Stock (Cabeçalhos)" styleClass="title"/>
        <Label text="Gerir pedidos e aprovações" styleClass="subtitle"/>
    </VBox>

    <HBox spacing="8">
        <Button text="Nova Requisição" onAction="#openCreateModal"/>
        <Button fx:id="btnAprovar" text="Aprovar Selecionada" onAction="#approveSelected" disable="true"/>
        <Button fx:id="btnRejeitar" text="Rejeitar Selecionada" onAction="#rejectSelected" disable="true"/>
    </HBox>

    <Label fx:id="resultCountLabel" text="0 resultado(s)" styleClass="field-label"/>

    <TableView fx:id="requisicaoTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="Id" prefWidth="60"/>
            <TableColumn fx:id="dhRegistoCol" text="Data Registo" prefWidth="150"/>
            <TableColumn fx:id="estadoCol" text="Estado" prefWidth="100"/>
            <TableColumn fx:id="descricaoCol" text="Descrição" prefWidth="250"/>
            <TableColumn fx:id="criadorCol" text="Criador" prefWidth="120"/>
            <TableColumn fx:id="validadorCol" text="Validador" prefWidth="120"/>
            <TableColumn fx:id="dhValidacaoCol" text="Data Validação" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>