<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.wmsdsktp.Controllers.SidebarController"
      styleClass="sidebar" spacing="0">

    <!-- Logo -->
    <VBox styleClass="sidebar-logo" alignment="CENTER_LEFT">
        <HBox>
            <Label text="⬡" styleClass="logo-icon"/>
            <Label text="Hermes" styleClass="logo-text"/>
        </HBox>

        <Label text="Logistics" styleClass="logo-subtext"/>
    </VBox>

    <!-- Nav Items -->
    <ScrollPane VBox.vgrow="ALWAYS" styleClass="sidebar-scroll" fitToWidth="true">
        <VBox styleClass="nav-section" spacing="2">

            <Label text="OVERVIEW" styleClass="nav-section-label"/>
            <Button fx:id="navDashboard" text="Dashboard" styleClass="nav-btn"
                    onAction="#onNavigate" userData="dashboard">
                <graphic><Label text="⊞" styleClass="nav-icon"/></graphic>
            </Button>

            <Label text="Resource Management" styleClass="nav-section-label"/>

            <Button fx:id="navStock" text="Stock" styleClass="nav-btn"
                    onAction="#onNavigate" userData="stock">
                <graphic><Label text="📦" styleClass="nav-icon"/></graphic>
            </Button>

            <Button fx:id="navProduct" text="Products" styleClass="nav-btn"
                    onAction="#onNavigate" userData="product">
                <graphic><Label text="🏷" styleClass="nav-icon"/></graphic>
            </Button>

            <Button fx:id="navRequisitions" text="Stock Requisitions" styleClass="nav-btn"
                    onAction="#onNavigate" userData="requisition">
                <graphic><Label text="🏷" styleClass="nav-icon"/></graphic>
            </Button>
            
            <Button fx:id="navWarehouses" text="Warehouses" styleClass="nav-btn"
                    onAction="#onNavigate" userData="warehouses">
                <graphic><Label text="🏢" styleClass="nav-icon"/></graphic>
            </Button>
            
            <Button fx:id="navVehicles" text="Fleet Vehicles" styleClass="nav-btn"
                    onAction="#onNavigate" userData="vehicles">
                <graphic><Label text="🚚" styleClass="nav-icon"/></graphic>
            </Button>
            
            <Button fx:id="navRoutes" text="Routes" styleClass="nav-btn"
                    onAction="#onNavigate" userData="routes">
                <graphic><Label text="🗺" styleClass="nav-icon"/></graphic>
            </Button>
            
            <Button fx:id="navTeams" text="Teams" styleClass="nav-btn"
                    onAction="#onNavigate" userData="teams">
                <graphic><Label text="👥" styleClass="nav-icon"/></graphic>
            </Button>

            <Label text="User Management" styleClass="nav-section-label"/>
            <Button fx:id="navUsers" text="Users" styleClass="nav-btn"
                    onAction="#onNavigate" userData="users">
                <graphic><Label text="👤" styleClass="nav-icon"/></graphic>
            </Button>


        </VBox>
    </ScrollPane>

    <!-- Footer -->
    <VBox styleClass="sidebar-footer">
        <Button fx:id="navSettings" text="Settings" styleClass="nav-btn"
                onAction="#onNavigate" userData="settings">
            <graphic><Label text="⚙" styleClass="nav-icon"/></graphic>
        </Button>
        <Button fx:id="btnLogout" text="Logout" styleClass="nav-btn"
                onAction="#onLogout">
            <graphic><Label text="⇥" styleClass="nav-icon"/></graphic>
        </Button>
    </VBox>

</VBox>